#!/usr/bin/env bash
# Persistent GitHub Actions runner in rootless Podman, one container + one volume per
# instance. Registered once by hand with a token from the repo's Settings → Actions →
# Runners → New self-hosted runner (single use, valid 1 h), so no PAT lives on badger.
#
#   gh-runner register [--no-default-labels] <instance> <repo-url> <labels> [volume...]
#   gh-runner run <instance>        # via systemd user unit gh-runner@<instance>.service
#
# Installed for both builder (CI) and github-runner (codesign).
set -euo pipefail

IMAGE=${GH_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:2.337.0}
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/gh-runner

usage() { sed -n '6,7s/^#   //p' "$0" >&2; exit 2; }

check_instance() {
    [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo "bad instance name: $1" >&2; exit 2; }
}

# Common container settings. Container uid 1001 (runner) is mapped to the host user, so
# the runner owns its volume and the host user's files (spool) are writable as usual.
podman_run() {
    local instance=$1; shift
    local args=(--rm --name "gh-runner-$instance"
        --userns=keep-id:uid=1001,gid=1001
        --cap-drop=all --security-opt=no-new-privileges
        -v "gh-runner-$instance:/home/runner")
    local v
    for v in "${VOLUMES[@]}"; do args+=(-v "$v"); done
    podman run "${args[@]}" "$@"
}

cmd=${1:-}; shift || true
case $cmd in
register)
    no_default=()
    if [[ ${1:-} == --no-default-labels ]]; then no_default=(--no-default-labels); shift; fi
    [[ $# -ge 3 ]] || usage
    instance=$1 url=$2 labels=$3; shift 3
    check_instance "$instance"
    VOLUMES=("$@")
    if podman volume exists "gh-runner-$instance"; then
        echo "instance $instance already exists (podman volume rm gh-runner-$instance to redo)" >&2
        exit 1
    fi
    read -rsp "Registration token: " ACTIONS_RUNNER_INPUT_TOKEN; echo
    export ACTIONS_RUNNER_INPUT_TOKEN
    podman pull "$IMAGE"
    podman volume create "gh-runner-$instance" >/dev/null
    podman_run "$instance" --env ACTIONS_RUNNER_INPUT_TOKEN "$IMAGE" \
        ./config.sh --unattended --url "$url" --name "badger-$instance" \
        --labels "$labels" "${no_default[@]}" --work _work
    mkdir -p "$CONF_DIR"
    declare -p VOLUMES >"$CONF_DIR/$instance.conf"
    echo "Registered. Start: systemctl --user enable --now gh-runner@$instance"
    ;;
run)
    [[ $# -eq 1 ]] || usage
    instance=$1
    check_instance "$instance"
    VOLUMES=()
    # shellcheck source=/dev/null
    source "$CONF_DIR/$instance.conf"
    # run.sh restarts the listener itself after a runner self-update.
    podman_run "$instance" "$IMAGE" ./run.sh
    ;;
*)
    usage
    ;;
esac
